# ─────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────

# Groq API key — used for chat completions (llama-3.1-8b-instant)
# and the prompt injection guardrail (llama-prompt-guard-2-22m).
# Get one free at console.groq.com
GROQ_API_KEY=

# ─────────────────────────────────────────────
# RAG tuning (optional — defaults shown)
# ─────────────────────────────────────────────

# Minimum cosine similarity score to return a chunk as context.
# Queries that retrieve nothing above this threshold get a canned refusal.
# Start at 0.35 and raise if off-topic questions leak through.
SIMILARITY_THRESHOLD=0.35

# Number of chunks to retrieve (top-k before threshold gate)
RAG_TOP_K=5

# ─────────────────────────────────────────────
# Rate limiting (optional — defaults shown)
# ─────────────────────────────────────────────

# Max requests per IP within the window
RATE_LIMIT_MAX=20

# Sliding window duration in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─────────────────────────────────────────────
# Future / Phase 5 (Upstash — leave blank for now)
# ─────────────────────────────────────────────

# Swap the in-memory rate limiter for Upstash Redis when deploying
# to multiple Vercel regions (in-memory state is per-instance).
# Get free credentials at upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
